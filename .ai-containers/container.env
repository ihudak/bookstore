# container.env — application environment for bookstore's AI sandbox.
# Docker env-file syntax: NAME=value, values are literal (no quotes, no expansion).

# PostgreSQL (sandbox.conf postgres=ON): role and databases the dev profile of
# books / storage / orders / ingest expects (database/pg/init/01-create-db.sql).
# Any password is accepted, so only the role has to exist.
POSTGRES_ROLES=pguser
POSTGRES_DATABASES=dt_books_books:pguser,dt_books_storage:pguser,dt_books_orders:pguser,dt_books_ingest:pguser

# MySQL (sandbox.conf mysql=ON): databases for clients / carts / payments /
# dynapay / ratings (database/mysql/init/01-create-db.sql). The dev profile
# connects as root with this password; your own sandbox user stays passwordless.
MYSQL_DATABASES=dt_books_clients,dt_books_carts,dt_books_payments,dt_books_dynapays,dt_books_ratings
MYSQL_USERS=root:p@ssw0rD!
